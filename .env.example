# Copy to .env.local and fill in. Never commit real values.
# The service key is NOT here and never belongs in client code (spec hard rule 7).

# URL of the Supabase project (development or production, per environment)
VITE_SUPABASE_URL=

# Public anon key — safe to ship to the client, RLS does the enforcing
VITE_SUPABASE_ANON_KEY=

# development | production
VITE_APP_ENV=development
