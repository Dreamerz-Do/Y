# Copy to .env.local and fill in. Never commit real values.
# The service key is NOT here and never belongs in client code (spec hard rule 7).

# URL of the Supabase project (development or production, per environment)
VITE_SUPABASE_URL=

# Public client key — safe to ship to the client, RLS does the enforcing.
# Use the project's publishable key (sb_publishable_...); the legacy anon key
# also works. Never the secret / service_role key (spec hard rule 7).
VITE_SUPABASE_ANON_KEY=

# development | production
VITE_APP_ENV=development
